APP_NAME="Insurence Bot v1.0"
APP_ENV=dev
TIMEZONE=Asia/Kolkata

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=demo_insurence
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DB_AUTO_BOOTSTRAP=true
DB_BOOTSTRAP_SEED=false

LLM_OPENAI_BASE_URL=https://api.openai.com/v1
LLM_OPENAI_API_KEY=replace_me
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2

EMBEDDING_OPENAI_BASE_URL=https://api.openai.com/v1
EMBEDDING_OPENAI_API_KEY=replace_me
EMBEDDING_MODEL=text-embedding-3-small

HOSPITAL_EXCEL_PATH=data/excel/hospitals.xlsx
GARAGE_EXCEL_PATH=data/excel/garages.xlsx
PDF_DIR=data/pdfs
VECTOR_DIR=data/vector
APP_LOG_FILE=logs/app.log
TRANSCRIPT_DIR=logs/transcripts
LOG_LEVEL=INFO

CHAT_HISTORY_TABLE=bot_chat_history

RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=4
